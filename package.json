{
  "name": "mutate4ts",
  "version": "1.0.0",
  "private": true,
  "description": "Mutation testing for TypeScript",
  "bin": {
    "mutate4ts": "dist/index.js"
  },
  "files": [
    "dist/**"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "test:coverage": "AGENT=1 bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "bun check",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --fix --type-aware",
    "rule-validator": "rule-validator",
    "stepdown": "stepdown-rule",
    "vet": "bun scripts/vet.ts"
  },
  "dependencies": {
    "arktype": "^2.2.0",
    "effect": "^3.19.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@graff/rule-validator": "github:graffhyrum/rule-validator#v1.1.3",
    "@graffhyrum/crap4ts": "github:graffhyrum/crap4ts#v2.1.3",
    "@types/bun": "^1.3.10",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0",
    "stepdown-rule": "github:graffhyrum/stepdown-rule#v0.4.5"
  },
  "peerDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260313.1"
  },
  "peerDependenciesMeta": {
    "@typescript/native-preview": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.4"
}
